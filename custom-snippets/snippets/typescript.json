{
	"Jest it condition": {
		"prefix": "jit",
		"body": [
			"it(`should return $1`, async() => {",
			"\t//* Arrange",
	  		"\t$2",
			"\t//* Act",
			"\t$3",
			"\t//* Assert",
			"\t$4",
			"});"
		]
	},

	"Describe jest": {
		"prefix": "jdesc",
		"body": [
			"describe(`$1`, () => {",
			"\tdescribe(`success`, () => {",
			"\t});",
			"\tdescribe(`failure`, () => {",
			"\t});",
			"});"
		]
	},

	"Try catch" : {
		"prefix": "tc",
		"body": [
			"try {",
			"\t",
			"} catch (err) {",
			"\tlogger.error(`[$1] ${prettyJSON(err)} ${ err }`);",
			"\t$2",
			"}"
		]
	},

	"Logger info": {
		"prefix": "li",
		"body": [
			"logger.info(`[$1] $2`);"
		]
	},

	"Logger info for class method": {
		"prefix": "lim",
		"body": [
			"logger.info(`[${this.CLASS_NAME}.\\${METHOD_NAME}] $1`);"
		]
	},

	"Logger debug": {
		"prefix": "ld",
		"body": [
			"logger.debug(`[$1][PREM-DEBUG] $2`);"
		]
	},

	"Literal helper": {
		"prefix": "lh",
		"body": [
			"$1 = \\${$1}"
		]
	},

  "Logger debug with json": {
		"prefix": "ldj",
		"body": [
			"logger.debug(`[$1][PREM-DEBUG] $2:${prettyJSON($2)}`);"
		]
	},

  "Logger error": {
		"prefix": "le",
		"body": [
      "logger.error(`[$1] $2`);"
		]
	},

	"Logger error for class method": {
		"prefix": "lem",
		"body": [
			"logger.error(`[${this.CLASS_NAME}.\\${METHOD_NAME}] $1`);"
		]
	},

  "Function scaffold": {
    "prefix": "fn",
    "body": [
      "public async $1({",
      "\t$2",
      "}:{",
      "\t$2",
      "}){",
      "\tconst METHOD_NAME='$1';",
      "\tconst identifier=`$3`;",
      "\ttry{",
      "\t\t",
      "\t} catch (err) {",
      "\t\tlogger.error(`[${this.CLASS_NAME}.\\${METHOD_NAME}] (\\${identifier}) ${prettyJSON(err)} ${ err }`);",
      "\t\treturn createFailureResponse(500, INTERNAL_SERVER_ERROR);",
      "\t}",
      "}"
    ]
  },

  "Arrow function scaffold": {
    "prefix": "afn",
    "body": [
      "$1 = async({",
      "}) => {",
      "}"
    ]
  },

  "Jest fn (m)ock (r)esolved (v)alue (o)nce": {
    "prefix": "mockres1",
    "body": [
      "$1 = jest.fn().mockResolvedValueOnce($2)"
    ]
  },

  "Jest fn (m)ock (r)e(t)urn (v)alue (o)nce": {
    "prefix": "mockret1",
    "body": [
      "$1 = jest.fn().mockReturnValueOnce($2)"
    ]
  },

  "Jest fn should have been called nth time with": {
    "prefix": "nthcalledwith",
    "body": [
      "expect($1).toHaveBeenNthCalledWith($2, $3)"
    ]
  },

  "Jest fn to have been called times": {
    "prefix": "calledtimes",
    "body": [
      "expect($1).toHaveBeenCalledTimes($2)"
    ]
  }





}
